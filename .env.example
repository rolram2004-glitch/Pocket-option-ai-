# Telegram: create the bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Optional: lock the bot to your Telegram numeric chat/user id.
TELEGRAM_ALLOWED_CHAT_ID=

# Optional AI interpreter for unstructured/forwarded signal messages.
# Never commit a real API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Local DEMO settings. This is virtual money, never represented as real funds.
DEMO_START_BALANCE=10000
DEFAULT_TRADE_AMOUNT=0.6
DEFAULT_EXPIRY_SECONDS=60
MIN_SIGNAL_CONFIDENCE=80
MAX_TRADE_AMOUNT=10
MAX_DAILY_TRADES=20
MAX_DAILY_LOSS=50
DEMO_PAYOUT=0.82

# Automatic RSI strategy (real candles -> automatic local DEMO orders).
# Optional: without a Twelve Data key, the bot automatically uses Kraken's
# public keyless feed for BTC/USD (and supported crypto symbols). FX requires
# your own Twelve Data key. OTC symbols are intentionally not fabricated.
TWELVE_DATA_API_KEY=
AUTO_SYMBOLS=EUR/USD;GBP/USD;BTC/USD
MARKET_INTERVAL=1min
STRATEGY_POLL_SECONDS=15
RSI_PERIOD=7
RSI_LOWER=14
RSI_UPPER=86

# SQLite database path. Railway users should attach a persistent volume if they
# want the ledger to survive redeploys.
DATABASE_PATH=pocket_ai.sqlite3
